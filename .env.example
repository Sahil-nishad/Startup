# Local development only; production must use a Supabase PostgreSQL connection.
DATABASE_MODE=pglite
PGLITE_PATH=.local/market-db
# Supabase Session Pooler URL (port 5432). Keep the password in the host secret store.
# Example shape: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=3
PUBLIC_APP_URL=http://localhost:8081
# Generate independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SYNC_SECRET=
ADMIN_ID=
# Store SHA256 of ADMIN_TOKEN on the server; raw token belongs only in operator tools.
ADMIN_TOKEN_SHA256=
ADMIN_TOKEN=
XFLOT_ENABLED=true
IPOS_MARKETS_ENABLED=true
# Reserved adapters: remain disabled pending licensed schema integration.
IPOGURU_ENABLED=false
IPOGURU_API_KEY=
OFFICIAL_FEED_ENABLED=false
OFFICIAL_FEED_API_KEY=
MASTER_SYNC_MINUTES=30
GMP_SYNC_MINUTES=30
SUBSCRIPTION_SYNC_MINUTES=30
SUBSCRIPTION_BATCH_SIZE=20
HISTORY_SYNC_MINUTES=1440
WORKER_INTERVAL_SECONDS=1800
PROVIDER_TIMEOUT_MS=15000
GMP_STALE_HOURS=24
SUBSCRIPTION_STALE_HOURS=1
MASTER_STALE_HOURS=48
API_REQUESTS_PER_MINUTE=600
# Public responses use conditional ETags and must revalidate; provider sync runs every 30 minutes.
